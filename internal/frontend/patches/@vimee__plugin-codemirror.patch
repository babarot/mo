diff --git a/dist/index.cjs b/dist/index.cjs
index 8ebd468f36519c154458d353415230265c7eb525..36fdc3fc74c290314a3ed163a6c494a284f30322 100644
--- a/dist/index.cjs
+++ b/dist/index.cjs
@@ -252,6 +252,7 @@ function attach(view, options = {}) {
     };
   }
   function shouldPreventDefault(e) {
+    if (e.metaKey) return false;
     const mode = ctx.mode;
     if (mode !== "insert") {
       if (e.ctrlKey && (e.key === "c" || e.key === "a")) return false;
@@ -282,9 +283,21 @@ function attach(view, options = {}) {
     ctx = { ...ctx, cursor: newCursor };
     syncCursorToEditor(newCursor);
   }
+  function syncCursorFromEditor() {
+    if (ctx.mode === "visual" || ctx.mode === "visual-line" || ctx.mode === "visual-block") {
+      return;
+    }
+    const offset = view.state.selection.main.head;
+    const editorCursor = offsetToCursor(buffer.getContent(), offset);
+    if (editorCursor.line !== ctx.cursor.line || editorCursor.col !== ctx.cursor.col) {
+      ctx = { ...ctx, cursor: editorCursor };
+    }
+  }
   function onKeyDown(e) {
     if (isComposing) return;
+    syncCursorFromEditor();
     syncViewport();
+    if (e.metaKey) return;
     if (e.ctrlKey) {
       const scrollKeys = {
         b: { direction: "up", amount: 1 },
@@ -319,8 +332,33 @@ function attach(view, options = {}) {
   function onCompositionEnd() {
     isComposing = false;
   }
+  function onMouseUp() {
+    const sel = view.state.selection.main;
+    if (sel.empty) {
+      if (ctx.mode === "visual" || ctx.mode === "visual-line" || ctx.mode === "visual-block") {
+        ctx = { ...ctx, mode: "normal", visualAnchor: null };
+        onModeChange?.("normal");
+        onAction?.({ type: "mode-change", mode: "normal" });
+      }
+      syncCursorFromEditor();
+      onAction?.({ type: "noop" });
+      return;
+    }
+    const content2 = buffer.getContent();
+    const anchorCursor = offsetToCursor(content2, sel.anchor);
+    const headCursor = offsetToCursor(content2, sel.head);
+    ctx = {
+      ...ctx,
+      mode: "visual",
+      visualAnchor: anchorCursor,
+      cursor: headCursor,
+    };
+    onModeChange?.("visual");
+    onAction?.({ type: "mode-change", mode: "visual" });
+  }
   const target = view.contentDOM;
   target.addEventListener("keydown", onKeyDown, { capture: true });
+  target.addEventListener("mouseup", onMouseUp);
   target.addEventListener("compositionstart", onCompositionStart);
   target.addEventListener("compositionend", onCompositionEnd);
   syncViewport();
@@ -328,8 +366,10 @@ function attach(view, options = {}) {
     getMode: () => ctx.mode,
     getCursor: () => ({ ...ctx.cursor }),
     getContent: () => buffer.getContent(),
+    getCommandLine: () => ctx.commandType ? ctx.commandType + ctx.commandBuffer : "",
     destroy: () => {
       target.removeEventListener("keydown", onKeyDown, { capture: true });
+      target.removeEventListener("mouseup", onMouseUp);
       target.removeEventListener("compositionstart", onCompositionStart);
       target.removeEventListener("compositionend", onCompositionEnd);
     }
